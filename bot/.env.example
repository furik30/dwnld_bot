# Telegram Bot Token from @BotFather
TELEGRAM_TOKEN=

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Your Telegram User ID (for admin commands)
OWNER_ID=

# Instagram username (optional, for reference)
INSTAGRAM_USERNAME=

# Max video/audio duration in seconds (e.g., 1200 for 20 minutes)
MAX_DURATION=1200

# Max tracks to download from a single playlist
MAX_PLAYLIST_ITEMS=10
