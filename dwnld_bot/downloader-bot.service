# /etc/systemd/system/downloader-bot.service
[Unit]
Description=Telegram Downloader Bot
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/downloader
ExecStart=/root/downloader/venv/bin/python /root/downloader/dwnld_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal